    "version": "0.2.0",
    "configurations": [

        {
            "name": "FastAPI",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "python": "/usr/local/python/current/bin/python",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Streamlit: brick_chat",
            "type": "python",
            "request": "launch",
            "module": "streamlit",
            "python": "/usr/local/python/current/bin/python",
            "args": [
                "run",
                "app/brick_chat.py"
            ],
            "justMyCode": true
        }
    ]
}